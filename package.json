{
  "name": "exifremove",
  "version": "1.0.1",
  "description": "Dependency-free Node.js module for removing EXIF metadata from JPEG images",
  "main": "src/exifremove.js",
  "types": "src/exifremove.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:workers": "vitest run --config vitest.config.workers.mts",
    "test:edge": "vitest run --config vitest.config.edge.ts",
    "typecheck": "tsc --project tsconfig.json",
    "format": "prettier --write .",
    "format:staged": "pretty-quick --staged"
  },
  "author": "James Cote (Coteh)",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.17.0",
    "@edge-runtime/vm": "^4.0.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.0",
    "husky": "^8.0.3",
    "prettier": "3.1.1",
    "pretty-quick": "^3.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  },
  "keywords": [
    "jpeg",
    "jpg",
    "exif",
    "remove",
    "remover",
    "strip"
  ],
  "files": [
    "/src",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Coteh/exifremove.git"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
